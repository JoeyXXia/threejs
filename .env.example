# Copy to .env at workspace root; never commit real secrets.
API_HOST=127.0.0.1
API_PORT=3000
# Used by Vite dev proxy only; browser requests use /api/health.
API_PROXY_TARGET=http://127.0.0.1:3000
DATABASE_URL=postgresql://warehouse:CHANGE_ME@127.0.0.1:5432/warehouse_twin
POSTGRES_PASSWORD=CHANGE_ME
# At least 12 characters; seed does not overwrite existing user credentials.
DEMO_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD
SESSION_TTL_SECONDS=3600
SESSION_SECURE=false
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
