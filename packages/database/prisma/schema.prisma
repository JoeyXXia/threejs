generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String
  createdAt    DateTime @default(now())
  sessions     Session[]
  access       WarehouseAccess[]
  auditLogs    AuditLog[]
  commands     IdempotencyRecord[]
  createdInbound InboundOrder[] @relation("InboundCreator")
  receivedInbound InboundOrder[] @relation("InboundReceiver")
  inspectedInbound InboundOrder[] @relation("InboundInspector")
  createdOutbound OutboundOrder[] @relation("OutboundCreator")
  allocatedOutbound OutboundOrder[] @relation("OutboundAllocator")
}

model Space {
  id         String @id @db.Uuid
  name       String
  createdAt  DateTime @default(now())
  warehouses Warehouse[]
}

model Warehouse {
  id        String @id @db.Uuid
  spaceId   String @db.Uuid
  name      String
  version   Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  space     Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  access    WarehouseAccess[]
  auditLogs AuditLog[]
  commands  IdempotencyRecord[]
  activeLayoutId String? @db.Uuid
  layouts LayoutVersion[] @relation("WarehouseLayouts")
  activeLayout LayoutVersion? @relation("ActiveLayout", fields: [spaceId, id, activeLayoutId], references: [spaceId, warehouseId, id], onDelete: Restrict, onUpdate: NoAction)
  locations Location[]
  skus Sku[]
  inboundOrders InboundOrder[]
  outboundOrders OutboundOrder[]
  @@unique([spaceId, id])
}

enum ZoneKind {
  INBOUND
  QC
  STORAGE
  PICKING
  OUTBOUND
  CHARGING
  TRANSIT
}

enum LayoutStatus {
  DRAFT
  PUBLISHED
}

enum Quality {
  HOLD
  RELEASED
}

enum MovementKind {
  OPENING
  TRANSFER
  RECEIPT
  DISPATCH
  COUNT_ADJUSTMENT
}

enum CountStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

enum InboundStatus {
  CREATED
  RECEIVED
  PASSED
  REJECTED
}

enum OutboundStatus {
  CREATED
  ALLOCATED
  DISPATCHED
}

enum TransportPhase {
  READY
  IN_TRANSIT
  STAGED
}

model LayoutVersion {
  id String @id @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  version Int
  status LayoutStatus @default(DRAFT)
  width Int
  depth Int
  cellSize Float @default(1)
  originX Float @default(0)
  originZ Float @default(0)
  createdAt DateTime @default(now())
  warehouse Warehouse @relation("WarehouseLayouts", fields: [spaceId, warehouseId], references: [spaceId, id], onDelete: Restrict)
  activeFor Warehouse[] @relation("ActiveLayout")
  zones LayoutZone[]
  racks Rack[]
  placements LayoutLocation[]
  countOrders CountOrder[]
  @@unique([spaceId, warehouseId, id])
  @@unique([spaceId, warehouseId, version])
}

model LayoutZone {
  id String @id @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  layoutId String @db.Uuid
  code String
  kind ZoneKind
  gridX Int
  gridZ Int
  sizeX Int
  sizeZ Int
  layout LayoutVersion @relation(fields: [spaceId, warehouseId, layoutId], references: [spaceId, warehouseId, id], onDelete: Restrict)
  racks Rack[]
  placements LayoutLocation[]
  @@unique([spaceId, warehouseId, layoutId, id])
  @@unique([layoutId, code])
}

model Rack {
  id String @id @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  layoutId String @db.Uuid
  zoneId String @db.Uuid
  code String
  gridX Int
  gridZ Int
  sizeX Int
  sizeZ Int
  levels Int
  levelHeight Float @default(1.5)
  layout LayoutVersion @relation(fields: [spaceId, warehouseId, layoutId], references: [spaceId, warehouseId, id], onDelete: Restrict)
  zone LayoutZone @relation(fields: [spaceId, warehouseId, layoutId, zoneId], references: [spaceId, warehouseId, layoutId, id], onDelete: Restrict)
  placements LayoutLocation[]
  @@unique([spaceId, warehouseId, layoutId, id])
  @@unique([layoutId, code])
}

// Stable business identity; coordinates and capacity live in the layout snapshot.
model Location {
  id String @id @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  code String
  kind ZoneKind
  warehouse Warehouse @relation(fields: [spaceId, warehouseId], references: [spaceId, id], onDelete: Restrict)
  placements LayoutLocation[]
  balances InventoryBalance[]
  movementsFrom InventoryMovement[] @relation("MovementSource")
  movementsTo InventoryMovement[] @relation("MovementDestination")
  transitTasks TransportTask[] @relation("TransitLocation")
  stagingTasks TransportTask[] @relation("StagingLocation")
  countOrders CountOrder[]
  inboundOrders InboundOrder[]
  @@unique([spaceId, warehouseId, id])
  @@unique([spaceId, warehouseId, code])
}

model CountOrder {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  locationId String @db.Uuid
  layoutId String @db.Uuid
  status CountStatus @default(OPEN)
  createdAt DateTime @default(now())
  submissionNote String?
  location Location @relation(fields: [spaceId, warehouseId, locationId], references: [spaceId, warehouseId, id], onDelete: Restrict, onUpdate: NoAction)
  layout LayoutVersion @relation(fields: [spaceId, warehouseId, layoutId], references: [spaceId, warehouseId, id], onDelete: Restrict, onUpdate: NoAction)
  lines CountLine[]
  @@index([spaceId, warehouseId, createdAt])
}

// The captured identity remains available even if the original balance is later removed.
model CountLine {
  countId String @db.Uuid
  balanceId String @db.Uuid
  skuId String @db.Uuid
  batchId String @db.Uuid
  skuCode String
  batchCode String
  quality Quality
  expected Int
  balanceVersion Int
  actual Int?
  count CountOrder @relation(fields: [countId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@id([countId, balanceId])
}

model LayoutLocation {
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  layoutId String @db.Uuid
  locationId String @db.Uuid
  zoneId String @db.Uuid
  rackId String? @db.Uuid
  gridX Int
  gridZ Int
  level Int @default(0)
  serviceX Int
  serviceZ Int
  capacity Int
  layout LayoutVersion @relation(fields: [spaceId, warehouseId, layoutId], references: [spaceId, warehouseId, id], onDelete: Restrict)
  location Location @relation(fields: [spaceId, warehouseId, locationId], references: [spaceId, warehouseId, id], onDelete: Restrict)
  zone LayoutZone @relation(fields: [spaceId, warehouseId, layoutId, zoneId], references: [spaceId, warehouseId, layoutId, id], onDelete: Restrict)
  rack Rack? @relation(fields: [spaceId, warehouseId, layoutId, rackId], references: [spaceId, warehouseId, layoutId, id], onDelete: Restrict)
  @@id([layoutId, locationId])
  @@unique([layoutId, gridX, gridZ, level])
}

model Sku {
  id String @id @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  code String
  name String
  unit String @default("piece")
  warehouse Warehouse @relation(fields: [spaceId, warehouseId], references: [spaceId, id], onDelete: Restrict)
  batches Batch[]
  @@unique([spaceId, warehouseId, id])
  @@unique([spaceId, warehouseId, code])
}

model Batch {
  id String @id @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  skuId String @db.Uuid
  code String
  expiresAt DateTime?
  producedAt DateTime?
  sku Sku @relation(fields: [spaceId, warehouseId, skuId], references: [spaceId, warehouseId, id], onDelete: Restrict)
  balances InventoryBalance[]
  movements InventoryMovement[]
  inboundOrders InboundOrder[]
  outboundOrders OutboundOrder[]
  @@unique([spaceId, warehouseId, skuId, id])
  @@unique([spaceId, warehouseId, skuId, code])
}

model InventoryBalance {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  locationId String @db.Uuid
  skuId String @db.Uuid
  batchId String @db.Uuid
  quality Quality
  onHand Int @default(0)
  reserved Int @default(0)
  version Int @default(0)
  updatedAt DateTime @updatedAt
  location Location @relation(fields: [spaceId, warehouseId, locationId], references: [spaceId, warehouseId, id], onDelete: Restrict)
  batch Batch @relation(fields: [spaceId, warehouseId, skuId, batchId], references: [spaceId, warehouseId, skuId, id], onDelete: Restrict)
  allocations Allocation[]
  @@unique([spaceId, warehouseId, locationId, skuId, batchId, quality])
  @@unique([spaceId, warehouseId, locationId, skuId, batchId, quality, id], map: "balance_allocation_scope_key")
}

model OutboundOrder {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  skuId String @db.Uuid
  batchId String @db.Uuid
  quantity Int
  status OutboundStatus @default(CREATED)
  version Int @default(0)
  reason String
  allocationReason String?
  createdById String @db.Uuid
  allocatedById String? @db.Uuid
  createdAt DateTime @default(now())
  allocatedAt DateTime?
  warehouse Warehouse @relation(fields: [spaceId, warehouseId], references: [spaceId, id], onDelete: Restrict, onUpdate: NoAction)
  batch Batch @relation(fields: [spaceId, warehouseId, skuId, batchId], references: [spaceId, warehouseId, skuId, id], onDelete: Restrict, onUpdate: NoAction)
  createdBy User @relation("OutboundCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocatedBy User? @relation("OutboundAllocator", fields: [allocatedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocations Allocation[]
  @@unique([spaceId, warehouseId, skuId, batchId, id], map: "outbound_allocation_scope_key")
  @@index([spaceId, warehouseId, createdAt])
}

model Allocation {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  orderId String @db.Uuid
  balanceId String @db.Uuid
  locationId String @db.Uuid
  skuId String @db.Uuid
  batchId String @db.Uuid
  quality Quality @default(RELEASED)
  quantity Int
  createdAt DateTime @default(now())
  order OutboundOrder @relation(fields: [spaceId, warehouseId, skuId, batchId, orderId], references: [spaceId, warehouseId, skuId, batchId, id], onDelete: Restrict, onUpdate: NoAction)
  balance InventoryBalance @relation(fields: [spaceId, warehouseId, locationId, skuId, batchId, quality, balanceId], references: [spaceId, warehouseId, locationId, skuId, batchId, quality, id], onDelete: Restrict, onUpdate: NoAction)
  task TransportTask?
  @@unique([orderId, balanceId])
  @@unique([spaceId, warehouseId, id], map: "allocation_task_scope_key")
  @@index([balanceId])
}

// READY and IN_TRANSIT tasks reserve their allocation's quantity at staging.
model TransportTask {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  allocationId String @unique @db.Uuid
  transitLocationId String @unique @db.Uuid
  stagingLocationId String @db.Uuid
  phase TransportPhase @default(READY)
  allocation Allocation @relation(fields: [spaceId, warehouseId, allocationId], references: [spaceId, warehouseId, id], onDelete: Restrict, onUpdate: NoAction)
  transit Location @relation("TransitLocation", fields: [spaceId, warehouseId, transitLocationId], references: [spaceId, warehouseId, id], onDelete: Restrict, onUpdate: NoAction)
  staging Location @relation("StagingLocation", fields: [spaceId, warehouseId, stagingLocationId], references: [spaceId, warehouseId, id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([spaceId, warehouseId, allocationId], map: "task_allocation_scope_key")
  @@index([stagingLocationId, phase])
}

// One SKU/batch, full receipt and full inspection; no partial operations in Day 8.
model InboundOrder {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  skuId String @db.Uuid
  batchId String @db.Uuid
  qcLocationId String @db.Uuid
  quantity Int
  status InboundStatus @default(CREATED)
  version Int @default(0)
  createdById String @db.Uuid
  receivedById String? @db.Uuid
  inspectedById String? @db.Uuid
  reason String
  receiptReason String?
  inspectionReason String?
  createdAt DateTime @default(now())
  receivedAt DateTime?
  inspectedAt DateTime?
  warehouse Warehouse @relation(fields: [spaceId, warehouseId], references: [spaceId, id], onDelete: Restrict, onUpdate: NoAction)
  batch Batch @relation(fields: [spaceId, warehouseId, skuId, batchId], references: [spaceId, warehouseId, skuId, id], onDelete: Restrict, onUpdate: NoAction)
  qcLocation Location @relation(fields: [spaceId, warehouseId, qcLocationId], references: [spaceId, warehouseId, id], onDelete: Restrict, onUpdate: NoAction)
  createdBy User @relation("InboundCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  receivedBy User? @relation("InboundReceiver", fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inspectedBy User? @relation("InboundInspector", fields: [inspectedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([spaceId, warehouseId, id])
  @@index([spaceId, warehouseId, createdAt])
}

// External receipts have no source; dispatches have no destination.
model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  warehouseId String @db.Uuid
  skuId String @db.Uuid
  batchId String @db.Uuid
  kind MovementKind
  sourceLocationId String? @db.Uuid
  sourceQuality Quality?
  destinationLocationId String? @db.Uuid
  destinationQuality Quality?
  quantity Int
  businessKey String
  actorType String
  actorId String
  reason String
  reference String
  createdAt DateTime @default(now())
  batch Batch @relation(fields: [spaceId, warehouseId, skuId, batchId], references: [spaceId, warehouseId, skuId, id], onDelete: Restrict)
  source Location? @relation("MovementSource", fields: [spaceId, warehouseId, sourceLocationId], references: [spaceId, warehouseId, id], onDelete: Restrict)
  destination Location? @relation("MovementDestination", fields: [spaceId, warehouseId, destinationLocationId], references: [spaceId, warehouseId, id], onDelete: Restrict)
  @@unique([spaceId, warehouseId, businessKey])
  @@index([spaceId, warehouseId, createdAt])
}

model WarehouseAccess {
  userId      String @db.Uuid
  spaceId     String @db.Uuid
  warehouseId String @db.Uuid
  role        Role
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [spaceId, warehouseId], references: [spaceId, id], onDelete: Cascade)
  @@id([userId, spaceId, warehouseId])
}

model Session {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId    String @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model AuditLog {
  id           String @id @default(uuid()) @db.Uuid
  spaceId      String @db.Uuid
  warehouseId  String @db.Uuid
  actorId      String @db.Uuid
  actorType    String @default("USER")
  action       String
  reason       String
  requestId    String @db.Uuid
  correlationId String?
  before       Json
  after        Json
  createdAt    DateTime @default(now())
  actor        User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  warehouse    Warehouse @relation(fields: [spaceId, warehouseId], references: [spaceId, id], onDelete: Restrict)
  @@index([spaceId, warehouseId, createdAt])
}

// Foundation only. Business command deduplication is implemented with its WMS phase.
model IdempotencyRecord {
  id          String @id @default(uuid()) @db.Uuid
  spaceId     String @db.Uuid
  warehouseId String @db.Uuid
  actorId     String @db.Uuid
  operation   String
  key         String
  requestHash String
  status      String
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  actor       User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [spaceId, warehouseId], references: [spaceId, id], onDelete: Restrict)
  @@unique([spaceId, warehouseId, actorId, operation, key])
}
