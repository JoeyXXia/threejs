{
  "name": "warehouse-twin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.14.x || >=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @warehouse-twin/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "node scripts/database.mjs generate",
    "db:migrate": "node scripts/database.mjs migrate",
    "seed": "node scripts/database.mjs seed",
    "db:local": "node scripts/local-postgres.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:integration": "pnpm --filter @warehouse-twin/api build && node scripts/integration.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.30",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
