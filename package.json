{
  "name": "warehouse-twin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": "22.14.x || 24.19.x" },
  "scripts": {
    "dev": "pnpm --parallel --filter @warehouse-twin/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.30",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
